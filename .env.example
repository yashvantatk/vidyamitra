# Required
GEMINI_API_KEY=your-gemini-api-key
# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.8-flash   # used when the main model is busy
GEMINI_RPM=10               # free-tier requests per minute for the chosen model
PORT=3000

# Twilio (needed to download photos / voice notes and to verify webhook signatures)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
VALIDATE_TWILIO_SIGNATURE=false   # set true in production
PUBLIC_URL=https://your-app.onrender.com   # used for signature validation

# State: leave empty for in-memory, or set a MongoDB Atlas URI
MONGODB_URI=

# Testing: answer with a fake tutor instead of calling Gemini
MOCK_LLM=false
